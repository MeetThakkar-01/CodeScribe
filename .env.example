# Add your actual values here
# DO NOT commit this file to git!

# GitHub App Configuration
GITHUB_APP_ID=your_app_id_here
GITHUB_PRIVATE_KEY_PATH=./your-app-name.private-key.pem
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Google Gemini Configuration
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Review Configuration
MIN_REVIEW_SEVERITY=low
AUTO_LABEL_ON_COMPLETE=true
READY_FOR_APPROVAL_LABEL=ready-for-approval
AI_REVIEW_COMPLETE_LABEL=ai-review-complete

# LangSmith Tracing (free tier; sign up at https://smith.langchain.com)
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=codescribe-demo

# RAG / Pinecone (leave PINECONE_API_KEY empty to disable retrieval)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=codescribe-code
EMBEDDING_MODEL=models/gemini-embedding-001
RAG_TOP_K=5
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200

# Jira Ticketing Agent
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your_atlassian_api_token_here
JIRA_PROJECT_KEY=CS
JIRA_MIN_SEVERITY=high

# Demo seeding script (scripts/demo_seed.py) — used only to pre-stage a buggy PR before recording
GITHUB_PAT=
DEMO_REPO=owner/simple-calculator
DEMO_PR_TITLE=Add more calculator operations
